---
import { PREGUNTAS } from "@/const";
---

<section id="preguntas" class="w-full pb-24 lg:pb-32">
	<div class="container border-t border-border pt-16 lg:pt-24">
		<div
			class="reveal mb-12 lg:mb-16 lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16 xl:gap-24"
			data-reveal
		>
			<div class="lg:col-start-2">
				<p class="text-xs font-medium uppercase tracking-[0.14em] text-calido-4">
					— 03 / Preguntas frecuentes
				</p>
				<h2 class="pt-5 text-[clamp(2rem,4vw,2.75rem)] leading-[1.08] text-calido-1 font-serif-ebgaramond">
					Lo que más <span class="text-calido-3 italic">me preguntan</span>.
				</h2>
			</div>
		</div>

		<div
			class="reveal lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16 xl:gap-24"
			data-reveal
			data-reveal-delay={80}
			data-faq
		>
			<div class="faq-answers hidden lg:order-2 lg:grid lg:self-start lg:pt-2">
				{
					PREGUNTAS.map((pregunta, index) => (
						<div
							id={`faq-panel-${index}`}
							class="faq-answer"
							data-active={index === 0 ? "true" : "false"}
							role="region"
							aria-labelledby={`faq-trigger-${index}`}
						>
							<p class="text-xs font-medium uppercase tracking-[0.14em] text-calido-3">
								Pregunta {String(index + 1).padStart(2, "0")}
							</p>
							<p class="pt-6 text-[clamp(1.5rem,2.4vw,2.25rem)] leading-[1.25] text-calido-1 font-serif-ebgaramond">
								{pregunta.a}
							</p>
						</div>
					))
				}
			</div>

			<div class="border-t border-border">
				{
					PREGUNTAS.map((pregunta, index) => (
						<div
							class="faq-item border-b border-border"
							data-faq-item
							data-active={index === 0 ? "true" : "false"}
						>
							<h3>
								<button
									type="button"
									class="faq-trigger flex w-full items-center justify-between gap-6 py-6 text-left lg:py-7"
									aria-expanded={index === 0 ? "true" : "false"}
									aria-controls={`faq-panel-${index}`}
									id={`faq-trigger-${index}`}
								>
									<span class="faq-question text-lg text-calido-1 font-serif-ebgaramond lg:text-xl">
										{pregunta.q}
									</span>
									<svg
										class="faq-chevron size-5 shrink-0 text-calido-3"
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="m6 9 6 6 6-6" />
									</svg>
								</button>
							</h3>
							<div class="faq-mobile-panel lg:hidden">
								<div class="faq-mobile-inner">
									<p class="pb-6 text-base leading-relaxed text-calido-4">{pregunta.a}</p>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	/* Desktop: todas las respuestas apiladas en la misma celda; solo la activa es visible */
	.faq-answer {
		grid-area: 1 / 1;
		opacity: 0;
		visibility: hidden;
		transform: translateY(0.75rem);
		transition:
			opacity 200ms ease-out,
			transform 300ms cubic-bezier(0.23, 1, 0.32, 1),
			visibility 0s linear 200ms;
	}

	.faq-answer[data-active="true"] {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		transition-delay: 80ms, 80ms, 0s;
	}

	/* Pregunta seleccionada resaltada, el resto atenuado */
	.faq-item {
		position: relative;
	}

	.faq-item::before {
		content: "";
		position: absolute;
		left: 0;
		top: -1px;
		height: 1px;
		width: 100%;
		background: var(--color-calido-3);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 350ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	.faq-item[data-active="true"]::before {
		transform: scaleX(1);
	}

	.faq-question {
		opacity: 0.55;
		transition:
			opacity 200ms ease,
			transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	.faq-item[data-active="true"] .faq-question,
	.faq-trigger:hover .faq-question {
		opacity: 1;
	}

	@media (min-width: 1024px) {
		.faq-item[data-active="true"] .faq-question {
			transform: translateX(0.5rem);
		}

		.faq-chevron {
			transform: rotate(-90deg);
		}
	}

	.faq-chevron {
		transition: transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	.faq-item[data-active="true"] .faq-chevron {
		transform: rotate(180deg);
	}

	@media (min-width: 1024px) {
		.faq-item[data-active="true"] .faq-chevron {
			transform: rotate(0deg);
		}
	}

	/* Mobile: acordeón inline, alto animado 0fr -> 1fr */
	.faq-mobile-panel {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 300ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	.faq-item[data-active="true"] .faq-mobile-panel {
		grid-template-rows: 1fr;
	}

	@media (min-width: 1024px) {
		.faq-mobile-panel {
			display: none;
		}
	}

	.faq-mobile-inner {
		overflow: hidden;
	}

	.faq-trigger {
		cursor: pointer;
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-answer,
		.faq-item::before,
		.faq-question,
		.faq-chevron,
		.faq-mobile-panel {
			transition: none;
		}
	}
</style>

<script>
	import { initReveal } from "@/scripts/reveal";

	function initFaq() {
		const root = document.querySelector("[data-faq]");
		if (!root || (root as HTMLElement).dataset.faqBound === "true") return;
		(root as HTMLElement).dataset.faqBound = "true";

		const items = root.querySelectorAll("[data-faq-item]");
		const answers = root.querySelectorAll(".faq-answer");

		items.forEach((item, index) => {
			const trigger = item.querySelector(".faq-trigger");
			if (!(trigger instanceof HTMLButtonElement)) return;

			trigger.addEventListener("click", () => {
				items.forEach((other, i) => {
					const active = i === index;
					other.setAttribute("data-active", String(active));
					other
						.querySelector(".faq-trigger")
						?.setAttribute("aria-expanded", String(active));
					answers[i]?.setAttribute("data-active", String(active));
				});
			});
		});
	}

	initReveal();
	initFaq();
	document.addEventListener("astro:page-load", () => {
		initReveal();
		initFaq();
	});
</script>
