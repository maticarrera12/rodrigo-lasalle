---
import Main from "@/layouts/main.astro";
import { ABONOS } from "@/const";
import CtaConsulta from "@/components/CtaConsulta.astro";
---

<Main title="Asesoramiento | Rodrigo Lasalle" description="Abonos de asesoramiento jurídico para personas y empresas: acompañamiento legal continuo, claro y a tu ritmo.">
      <section class="w-full pt-28 pb-8 lg:pt-32 lg:pb-16">
        <div class="container">
          <div class="grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:items-start lg:gap-16 xl:gap-24" data-tab-anchor>
            <div class="reveal min-w-0 lg:sticky lg:top-28 lg:self-start" data-reveal>
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-calido-4">
                — 05 / Asesoramiento
              </p>
              <h1 class="pt-4 text-[clamp(2.25rem,4.5vw,3rem)] leading-tight text-calido-1 font-serif-ebgaramond">
                Asesoramiento legal <span class="text-calido-3 italic">permanente</span>.
              </h1>
              <p class="max-w-md pt-6 text-base leading-relaxed text-calido-4 lg:text-lg">
                Planes diseñados para inmobiliarias, consorcios y empresas que necesitan respaldo jurídico continuo.
              </p>

              <div
                class="tab-list -mx-4 mt-10 flex overflow-x-auto border-b border-border px-4 lg:mx-0 lg:flex-col lg:overflow-visible lg:border-b-0 lg:border-t lg:px-0"
                role="tablist"
                aria-label="Planes de asesoramiento"
                data-tab-list
              >
                {
                  ABONOS.map((abono, index) => (
                    <button
                      type="button"
                      role="tab"
                      id={`tab-${abono.id}`}
                      data-tab-btn={abono.id}
                      aria-selected={index === 0 ? "true" : "false"}
                      aria-controls={`panel-${abono.id}`}
                      class="tab relative shrink-0 cursor-pointer whitespace-nowrap px-4 py-4 text-left text-base text-calido-1 font-serif-ebgaramond lg:border-b lg:border-border lg:px-0 lg:py-5 lg:text-xl"
                    >
                      {abono.label}
                    </button>
                  ))
                }
              </div>
            </div>

            <div class="reveal min-w-0" data-reveal data-reveal-delay={120}>
              {
                ABONOS.map((abono, index) => (
                  <div
                    id={`panel-${abono.id}`}
                    role="tabpanel"
                    aria-labelledby={`tab-${abono.id}`}
                    data-tab-panel={abono.id}
                    hidden={index !== 0}
                  >
                    <p class="max-w-2xl text-lg leading-relaxed text-calido-4">{abono.bajada}</p>

                    <div class="pt-12">
                      <p class="mb-6 text-xs font-medium uppercase tracking-[0.14em] text-calido-4">
                        Qué incluye
                      </p>
                      <div class="grid gap-3 sm:grid-cols-2">
                        {abono.incluye.map((grupo) => (
                          <div class="rounded-2xl bg-card p-5">
                            <p class="mb-3 text-sm font-medium text-calido-1">{grupo.titulo}</p>
                            <ul class="m-0 list-none space-y-1 p-0">
                              {grupo.items.map((item) => (
                                <li class="flex items-start gap-2 text-sm leading-relaxed text-calido-4">
                                  <span class="mt-0.5 shrink-0 text-calido-3" aria-hidden="true">·</span>
                                  {item}
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div class="pt-12">
                      <p class="mb-6 text-xs font-medium uppercase tracking-[0.14em] text-calido-4">
                        Beneficios
                      </p>
                      <ul class="m-0 grid list-none gap-x-10 gap-y-3 p-0 sm:grid-cols-2">
                        {abono.beneficios.map((b) => (
                          <li class="flex items-start gap-3">
                            <span class="mt-0.5 shrink-0 text-calido-3" aria-hidden="true">✓</span>
                            <span class="text-base leading-relaxed text-calido-1">{b}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <blockquote class="mt-12 border-t border-border pt-10">
                      <p class="max-w-2xl text-[clamp(1.35rem,2.4vw,1.875rem)] leading-[1.45] text-calido-1 font-serif-ebgaramond italic">
                        "{abono.cierre}"
                      </p>
                    </blockquote>
                  </div>
                ))
              }
            </div>
          </div>

          {
            ABONOS.map((abono, index) => (
              <div data-tab-cta={abono.id} hidden={index !== 0}>
                <CtaConsulta
                  titleTop="Asesoramiento legal"
                  titleAccent="a la altura de tus desafíos."
                  text={`¿Te interesa el asesoramiento para ${abono.label}? Escribime y armamos una propuesta a la medida de tu organización.`}
                  whatsappMessage={`Hola, me interesa el asesoramiento para ${abono.label}.`}
                />
              </div>
            ))
          }
        </div>
      </section>
    </Main>

<style is:global>
  html {
    overflow-anchor: none;
  }
</style>

<style>
  .tab {
    opacity: 0.55;
    transition: opacity 200ms ease;
  }

  .tab:hover,
  .tab[aria-selected="true"] {
    opacity: 1;
  }

  .tab::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--color-calido-3);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 350ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .tab[aria-selected="true"]::after {
    transform: scaleX(1);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  [data-tab-panel].is-entering,
  [data-tab-cta].is-entering {
    animation: panel-in 300ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .tab,
    .tab::after {
      transition: none;
    }

    [data-tab-panel].is-entering,
    [data-tab-cta].is-entering {
      animation: none;
    }
  }
</style>

<script is:inline>
  function initTabs() {
    var tabList = document.querySelector("[data-tab-list]");
    if (!tabList || tabList.dataset.bound === "true") return;
    tabList.dataset.bound = "true";

    var buttons = tabList.querySelectorAll("[data-tab-btn]");

    function show(selector, target) {
      document.querySelectorAll(selector).forEach(function (el) {
        var isTarget = el.getAttribute(selector.slice(1, -1)) === target;
        el.classList.remove("is-entering");
        el.hidden = !isTarget;
        if (isTarget) {
          void el.offsetWidth;
          el.classList.add("is-entering");
        }
      });
    }

    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var target = btn.getAttribute("data-tab-btn");
        buttons.forEach(function (b) {
          b.setAttribute("aria-selected", b === btn ? "true" : "false");
        });
        var anchor = document.querySelector("[data-tab-anchor]");
        var top = anchor ? anchor.getBoundingClientRect().top : 0;
        var needsScroll = top < 0;

        if (needsScroll) {
          document.body.style.minHeight = document.documentElement.scrollHeight + "px";
        }

        show("[data-tab-panel]", target);
        show("[data-tab-cta]", target);

        if (needsScroll) {
          var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top: window.scrollY + top - 112, behavior: reduce ? "auto" : "smooth" });
          setTimeout(function () {
            document.body.style.minHeight = "";
          }, 900);
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initTabs);
  initTabs();
</script>

<script>
  import { initReveal } from "@/scripts/reveal";
  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>
