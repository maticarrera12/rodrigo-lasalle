---
import Main from "@/layouts/main.astro";
import { AREAS } from "@/const";
import type { Area } from "@/const";
import CtaConsulta from "@/components/CtaConsulta.astro";

export function getStaticPaths() {
  return AREAS.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

interface Props {
  area: Area;
}

const { area } = Astro.props;
---

<Main title={`${area.t} | Rodrigo Lasalle`} description={`Asesoramiento legal en ${area.t} en Zona Norte, Buenos Aires. Estudio Lasalle.`}>
      <section class="w-full pt-28 pb-8 lg:pt-32 lg:pb-16">
        <div class="container">
          <div class="reveal mb-12" data-reveal>
            <nav aria-label="Breadcrumb" class="text-xs font-medium uppercase tracking-[0.14em] text-calido-4">
              <a href="/especialidades" class="back-link group inline-flex items-center gap-1.5 text-calido-3">
                <span
                  class="shrink-0 transition-transform duration-300 ease-out group-hover:-translate-x-1"
                  aria-hidden="true">←</span
                >
                <span class="back-link-text relative">Especialidades</span>
              </a>
              <span class="px-1.5" aria-hidden="true">/</span>
              <span aria-current="page">{area.n}</span>
            </nav>
            <h1 class="pt-4 text-[clamp(2.25rem,4.5vw,3rem)] leading-tight text-calido-1 font-serif-ebgaramond italic">
              {area.t}
            </h1>
          </div>

          <div class="grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-20">
            <div class="reveal" data-reveal data-reveal-delay={80}>
              <p class="text-lg leading-relaxed text-calido-4 lg:text-xl lg:leading-relaxed">
                {area.descripcionLarga}
              </p>
            </div>

            <div class="reveal" data-reveal data-reveal-delay={160}>
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-calido-4 mb-6">
                Servicios incluidos
              </p>
              <ul class="relative grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2 sm:gap-x-10 sm:before:absolute sm:before:inset-y-0 sm:before:left-1/2 sm:before:w-px sm:before:-translate-x-1/2 sm:before:bg-border/60">
                {
                  area.servicios.map((servicio) => (
                    <li class="flex items-center rounded-2xl bg-card px-5 py-4 text-base leading-snug text-calido-1 transition-[transform,background-color] duration-200 ease-out hover:-translate-y-0.5 hover:bg-muted">
                      {servicio}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <CtaConsulta
            eyebrow="Hablemos de tu caso"
            titleTop="¿Tenés un caso de"
            titleAccent={`${area.t}?`}
            text="Contame tu situación. La primera consulta es para entender qué te pasa y ver si te puedo ayudar."
            whatsappMessage={`Hola, quería consultar sobre ${area.t}.`}
          />
        </div>
      </section>
    </Main>

<style>
  .back-link {
    text-decoration: none;
  }

  .back-link-text::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    opacity: 0.55;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .back-link:hover .back-link-text::after {
    transform: scaleX(1);
  }
</style>

<script>
  import { initReveal } from "@/scripts/reveal";

  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>
